# howldr ProofWorks — API environment configuration
# Copy this file to .env and fill in your values
# Never commit .env to source control
#
# howldr's hosted deployment keeps these as Railway service variables and runs
# the bootstrap scripts via `railway run`. Self-hosted: put them in .env (or your
# platform's secret store) and run the scripts with plain `node`.

# ─── Database ─────────────────────────────────────────────────────────────────

# PostgreSQL connection string (Supabase Postgres in production)
DATABASE_URL=postgresql://proofworks:password@localhost:5432/proofworks

# ─── Supabase Auth (ADR 0001: web app signs in, API only verifies) ───────────

# JWT secret used to verify Supabase access tokens on API requests
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Project URL + secret (service-role) key — used by the bootstrap CLI
# scripts (create-tenant, invite-user), not by the API itself
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# ─── LiquidFiles ──────────────────────────────────────────────────────────────

# Base URL of your LiquidFiles instance (no trailing slash)
LIQUIDFILES_BASE_URL=https://files.yourcompany.com

# API key for the ProofWorks service account
# Retrieve from: GET /users/{id}/api_key in LiquidFiles admin
LIQUIDFILES_API_KEY=your_service_account_api_key_here

# Only for appliances that send receipt callbacks (v4.3 doesn't — receipts are
# polled). Verifies POST /api/webhooks/liquidfiles.
LIQUIDFILES_WEBHOOK_SECRET=your_webhook_secret_here

# Share that holds the per-policy folder tree, and the folder id of its root
LIQUIDFILES_SHARE_NAME=policies
LIQUIDFILES_ROOT_FOLDER_ID=your_root_folder_id_here

# ─── Application ──────────────────────────────────────────────────────────────

PORT=4000
NODE_ENV=development

# Base URL of the web app (used in notification links)
APP_BASE_URL=https://policies.yourcompany.com

# Domain the API itself is served on. Requests to this host are never
# treated as a tenant custom domain (tenants there must use /t/{slug}/...)
HOWLDR_APP_DOMAIN=api.howldr.com

# Comma-separated allowlist of origins for CORS (the web SPA's origins).
# Unset = any origin may call; the JWT still gates every protected route.
# CORS_ORIGINS=https://app.howldr.com,http://localhost:3000

# ─── Scheduler ────────────────────────────────────────────────────────────────

# Days before review_due to send advance notice
REVIEW_ADVANCE_NOTICE_DAYS=30

# Grace period after review_due before overdue escalation
REVIEW_GRACE_PERIOD_DAYS=30

# Comma-separated days after distribution to send acceptance reminders
ACCEPTANCE_REMINDER_DAYS=3,7,14

# ─── Notifications ────────────────────────────────────────────────────────────

# Governance lead email — receives overdue review escalations
GOVERNANCE_LEAD_EMAIL=governance@yourcompany.com

# ─── Web app ──────────────────────────────────────────────────────────────────

# The web app has its own settings — see web/.env.example.
