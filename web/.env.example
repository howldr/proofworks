# howldr ProofWorks — web app environment configuration
# Copy to .env.local for local dev. NEXT_PUBLIC_* values are baked into the
# static build, so set them in your build environment (e.g. Cloudflare Pages)
# and rebuild after changing them. None of these are secrets.

# The ProofWorks API (this repo's src/). For frontend work without a database,
# run `node scripts/dev-api-stub.js` from the repo root and use
# http://localhost:4100. Unset falls back to howldr's hosted API.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Supabase project used for sign-in (Google / Microsoft OAuth). The publishable
# key is the public client key — never the secret (service-role) key.
# Leave both unset to browse the app with demo data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here
